---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found">
	<div class="site">
		<h1>Page not found</h1>
		<p>
			Sorry, there’s nothing here. It may have moved, so try the{" "}
			<a href="/">home page</a> or the <a href="/blog/">blog</a>,{" "}
			<a href="/walks/">walks</a> and <a href="/travel/">travel</a> sections.
		</p>
	</div>
</SiteLayout>

<style>
	p a {
		color: var(--color-accent);
	}
</style>
