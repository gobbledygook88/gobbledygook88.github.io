---
import Landscape from "../components/Landscape.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const sections = [
	{ label: "Blog", href: "/blog/" },
	{ label: "Walks", href: "/walks/" },
	{ label: "Travel", href: "/travel/" },
];
---

<SiteLayout title="Biscuit Crumbs" showBanner={false}>
	<div class="home">
		<h1>Biscuit Crumbs</h1>
		<nav aria-label="Sections">
			<ul>
				{
					sections.map(({ label, href }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<Landscape />
</SiteLayout>

<style>
	/* The home page uses the browser's base size, unlike the 14px content pages */
	.home {
		display: grid;
		place-content: center;
		min-block-size: 100svh;
		font-size: 1rem;
	}

	h1 {
		color: var(--color-text-strong);
		font-weight: normal;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
		line-height: 1.8;
	}

	a {
		color: var(--color-muted);
		letter-spacing: var(--tracking-wide);

		&:hover,
		&:focus-visible {
			color: var(--color-text);
		}
	}
</style>
