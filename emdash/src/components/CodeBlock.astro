---
/** Portable Text `code` block: highlighted on the server. */
import { highlightCode } from "../lib/highlight";

interface Props {
	node: { code?: string; language?: string; filename?: string };
}

const { node } = Astro.props;
if (!node?.code) return null;

const html = await highlightCode(node.code, node.language);
---

<figure class="code-block">
	{node.filename && <figcaption>{node.filename}</figcaption>}
	<Fragment set:html={html} />
</figure>

<style>
	.code-block {
		margin: 1em 0;
	}

	figcaption {
		padding: 0.2em 0.4em;
		border: 1px solid var(--color-border);
		border-block-end: none;
		background-color: var(--color-code-background);
		color: var(--color-code-text);
		font-family: var(--font-code);
		font-size: 0.9em;
	}

	.code-block :global(pre) {
		margin: 0;
		padding: 1em;
		overflow-x: auto;
		border: 1px solid var(--color-border);
		line-height: 1.3;
		text-align: start;
	}

	.code-block :global(code) {
		font-family: var(--font-code);
	}
</style>
