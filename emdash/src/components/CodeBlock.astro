---
/**
 * Portable Text `code` block. The server sends plain, readable code;
 * scripts/code-highlighter.ts colours it in the browser, and is only
 * downloaded on pages that have code.
 */
interface Props {
	node: { code?: string; language?: string; filename?: string };
}

const { node } = Astro.props;
if (!node?.code) return null;
---

<figure class="code-block">
	{node.filename && <figcaption>{node.filename}</figcaption>}
	<pre><code data-language={node.language}>{node.code}</code></pre>
</figure>

<script>
	if (document.querySelector("pre code[data-language]")) {
		void import("../scripts/code-highlighter");
	}
</script>

<style>
	.code-block {
		margin: 1em 0;
	}

	figcaption {
		padding: 0.2em 0.4em;
		border: 1px solid var(--color-border);
		border-block-end: none;
		background-color: var(--color-code-background);
		color: var(--color-code-text);
		font-family: var(--font-code);
		font-size: 0.9em;
	}

	pre {
		margin: 0;
		padding: 1em;
		overflow-x: auto;
		border: 1px solid var(--color-border);
		background-color: var(--color-code-background);
		color: var(--color-code-text);
		line-height: 1.3;
		text-align: start;
	}

	code {
		font-family: var(--font-code);
	}

	/* highlight.js makes <code> its own padded, scrolling box; keep that on the <pre> */
	pre :global(code.hljs) {
		display: inline;
		overflow: visible;
		padding: 0;
		background: none;
	}
</style>
