---
/**
 * Decorative line along the bottom of the home page. It's drawn on the server
 * so it shows without JavaScript, then redrawn whenever the visitor taps.
 */
import { drawCrumbTrail, toSvgPoints, TRAIL_HEIGHT, TRAIL_WIDTH } from "../scripts/crumb-trail";
---

<svg
	class="crumb-trail"
	data-testid="crumb-trail"
	viewBox={`0 0 ${TRAIL_WIDTH} ${TRAIL_HEIGHT}`}
	preserveAspectRatio="xMidYMid meet"
	aria-hidden="true"
	focusable="false"
>
	<polyline points={toSvgPoints(drawCrumbTrail())}></polyline>
</svg>

<script>
	import { drawCrumbTrail, toSvgPoints } from "../scripts/crumb-trail";

	const line = document.querySelector<SVGPolylineElement>(".crumb-trail polyline");
	if (line) {
		document.addEventListener("click", () => {
			line.setAttribute("points", toSvgPoints(drawCrumbTrail()));
		});
	}
</script>

<style>
	.crumb-trail {
		position: fixed;
		inset-inline: 0;
		inset-block-end: 0;
		inline-size: 100%;
		pointer-events: none;
	}

	polyline {
		fill: none;
		stroke: currentColor;
		stroke-width: 0.5;
		color: var(--color-text-strong);
	}
</style>
