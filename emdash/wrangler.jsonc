{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "biscuit-crumbs-staging",
	// "Marcus Mo" account (owns marcusmo.co.uk)
	"account_id": "943f81090ebc4eaa1ccb18369073b502",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "biscuit-crumbs-staging",
			// Created in WEUR (2026-11-21)
			"database_id": "2974d052-7782-4915-bb1a-0180ae131982",
		},
	],
	// Astro sessions (auto-provisioned by the first deploy; pinned so CI never re-provisions)
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "ba888d0d64c940a886b3b095d155390f",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "biscuit-crumbs-media-staging",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// PR Previews (`wrangler preview`). Version URLs aren't generated for Workers
	// with Durable Objects, so PRs use Previews instead. Bindings aren't inherited:
	// every Preview shares the *staging* D1/R2/KV — never production. Each Preview
	// gets its own Durable Object namespace. Cron triggers don't run on Previews.
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "biscuit-crumbs-staging",
				"database_id": "2974d052-7782-4915-bb1a-0180ae131982",
			},
		],
		"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "biscuit-crumbs-media-staging" }],
		"kv_namespaces": [{ "binding": "SESSION", "id": "ba888d0d64c940a886b3b095d155390f" }],
		"durable_objects": {
			"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
		},
		"images": { "binding": "IMAGES" },
	},
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	"env": {
		// marcusmo.co.uk. CI deploys it on every merge to main (CLOUDFLARE_ENV=production
		// at build time). Bindings aren't inherited from the top level (staging), so
		// every one is repeated here, pointing at production's own resources (WEUR).
		"production": {
			"name": "biscuit-crumbs",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "biscuit-crumbs",
					"database_id": "aec84c16-7bf3-4b0d-8b3e-8a26f31ebd03",
				},
			],
			"kv_namespaces": [{ "binding": "SESSION", "id": "382b49789a524cb0a06afcff2ea1b9bd" }],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "biscuit-crumbs-media" }],
			"durable_objects": {
				"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
			},
			"exports": {
				"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
			},
			"triggers": {
				"crons": ["* * * * *"],
			},
		},
	},
}
